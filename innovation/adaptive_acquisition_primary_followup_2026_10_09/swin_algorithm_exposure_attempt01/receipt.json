  "lines": [
    {
      "id": "algx1.l1",
      "text": "# RandRot: transforms of random rotation"
    },
    {
      "id": "algx1.l2",
      "text": "# Cutout: transforms of cutout"
    },
    {
      "id": "algx1.l3",
      "text": "# Encoder: swin transformer encoder"
    },
    {
      "id": "algx1.l4",
      "text": "# RecHead: reconstruction head"
    },
    {
      "id": "algx1.l5",
      "text": "# RotHead: rotation head"
    },
    {
      "id": "algx1.l6",
      "text": "# CnHead: contrastive head"
    },
    {
      "id": "algx1.l7",
      "text": "# Linpaint: reconstruction loss"
    },
    {
      "id": "algx1.l8",
      "text": "# Lrot: rotation loss"
    },
    {
      "id": "algx1.l9",
      "text": "# Lcontrast: contrastive loss"
    },
    {
      "id": "algx1.l10",
      "text": "for x in Loader: # minibatch of samples"
    },
    {
      "id": "algx1.l11",
      "text": "x1, rot1 = RandRot(x)"
    },
    {
      "id": "algx1.l12",
      "text": "x2, rot2 = RandRot(x)"
    },
    {
      "id": "algx1.l13",
      "text": "x1’, x2’ = Cutout(x1), Cutout(x2)"
    },
    {
      "id": "algx1.l14",
      "text": "z1, z2 = Encoder(x1’), Encoder(x2’)"
    },
    {
      "id": "algx1.l15",
      "text": "rec1, rec2 = RecHead(z1), RecHead(z2)"
    },
    {
      "id": "algx1.l16",
      "text": "contr1, contr2 = CnHead(z1), CnHead(z2)"
    },
    {
      "id": "algx1.l17",
      "text": "r1, r2 = RotHead(z1), RotHead(z2)"
    },
    {
      "id": "algx1.l18",
      "text": "rot, r = torch.cat(rot1, rot2), torch.cat(r1, r2)"
    },
    {
      "id": "algx1.l19",
      "text": "rec, x = torch.cat(rec1, rec2), torch.cat(x1, x2)"
    },
    {
      "id": "algx1.l20",
      "text": "loss = Linpaint(rec,x) + Lrot(r,rots) + Lcontrast(contr1,contr2)"
    },
    {
      "id": "algx1.l21",
      "text": "loss.backward() # back-propagate"
    },
    {
      "id": "algx1.l22",
      "text": ""
    }
  ],
